# ─────────────────────────────────────────────────────────────
#  Insight Hub React app settings
#  Copy this file to ".env" (same folder) and fill in the values.
#  After changing this file, stop "npm run dev" (Ctrl+C) and start it again.
# ─────────────────────────────────────────────────────────────

# entra = real Microsoft (Tata Steel Office 365) sign-in
# dev   = TEST ONLY: you type a name instead of signing in
# Must match AUTH_MODE in backend\.env
VITE_AUTH_MODE=dev

# From the Azure / Entra app registration (needed when VITE_AUTH_MODE=entra)
VITE_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
