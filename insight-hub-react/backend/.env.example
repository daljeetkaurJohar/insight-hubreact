# ─────────────────────────────────────────────────────────────
#  Insight Hub backend settings
#  Copy this file to ".env" (same folder) and fill in the values.
# ─────────────────────────────────────────────────────────────

# Port the API server listens on
PORT=3001

# ── DATABASE ─────────────────────────────────────────────────
# DB_CLIENT = mssql  -> Microsoft SQL Server (Express / Developer / Azure SQL)
# DB_CLIENT = mysql  -> MySQL or MariaDB
DB_CLIENT=mssql
DB_HOST=localhost
# SQL Server default port is 1433, MySQL default port is 3306
DB_PORT=1433
DB_NAME=InsightHub
DB_USER=insighthub_app
DB_PASSWORD=ChangeMe_Str0ng!
# SQL Server only: set to true for Azure SQL, false for SQL Server on your laptop
DB_ENCRYPT=false

# ── LOGIN (Single Sign-On) ───────────────────────────────────
# AUTH_MODE = entra -> real Microsoft (Tata Steel Office 365) sign-in
# AUTH_MODE = dev   -> TEST ONLY: no Microsoft sign-in, you type a name.
#                      Never use "dev" on a server other people can reach.
AUTH_MODE=dev

# From the Azure / Entra app registration (needed when AUTH_MODE=entra)
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# ── FILES ────────────────────────────────────────────────────
# Folder where uploaded images are saved
UPLOAD_DIR=uploads
# Largest image allowed, in megabytes
MAX_IMAGE_MB=8
